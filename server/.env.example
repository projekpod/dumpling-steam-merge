# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
MOCHI_DEVICE_HASH_KEY=

# Optional. Set only if a trusted ingress overwrites this header.
MOCHI_TRUSTED_IP_HEADER=

# Needed only to activate the signed AdMob integration.
ADMOB_SSV_AD_UNIT=
ADMOB_SSV_REWARD_ITEM=
ADMOB_SSV_REWARD_AMOUNT=

# Needed only to activate the signed offerwall integration.
OFFERWALL_HMAC_SECRET=
OFFERWALL_REWARDS={}
OFFERWALL_IP_ALLOWLIST=
