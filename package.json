{
  "name": "dumpling-steam-merge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "npm run build -- --mode crazygames",
    "build:playgama": "npm run build -- --mode playgama",
    "build:admob": "npm run build -- --mode admob",
    "test": "vitest run --project unit",
    "test:simulation": "vitest run --project economy",
    "test:smoke": "playwright test",
    "preview": "vite preview",
    "media:portal": "node scripts/portal-media.mjs",
    "media:clips": "node scripts/gameplay-clips.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^24.19.2",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
